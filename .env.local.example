OPENAI_API_KEY=sk-your-key-here
MICROSOFT_CLIENT_ID=your-azure-app-client-id
MICROSOFT_CLIENT_SECRET=your-azure-app-client-secret
MICROSOFT_TENANT_ID=common
MICROSOFT_SESSION_SECRET=replace-with-at-least-32-random-characters
# Set this to your deployed callback URL, for example:
# MICROSOFT_REDIRECT_URI=https://your-jarvis-domain.vercel.app/api/microsoft/callback
JARVIS_TEXT_MODEL=gpt-6-astra
JARVIS_BUILDER_MODEL=gpt-6-astra
JARVIS_REASONING_EFFORT=high
JARVIS_REALTIME_MODEL=gpt-realtime-2.1
JARVIS_VOICE=marin
JARVIS_ACCESS_PASSWORD=replace-with-a-strong-private-password

# Optional private interview campaign. Keep real values in Vercel, never in Git.
JARVIS_INTERVIEW_ROLE=your-interview-role
JARVIS_INTERVIEW_INTERVIEWER=your-interviewer-name
JARVIS_INTERVIEW_START=YYYY-MM-DDTHH:MM:SS-04:00
JARVIS_INTERVIEW_END=YYYY-MM-DDTHH:MM:SS-04:00
JARVIS_INTERVIEW_TIME_ZONE=America/New_York
JARVIS_INTERVIEW_PREP_DAYS=3
JARVIS_INTERVIEW_BACKGROUND=your-private-career-summary
